<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="projetopdm.Sobre"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Sobre"
    BackgroundColor="White">

    <VerticalStackLayout
        Padding="10,20"
        Spacing="4"
        HorizontalOptions="Fill">

        <Label
            Text="Sistema Acadêmico"
            FontSize="20"
            FontAttributes="Bold"
            TextColor="#222222"
            HorizontalOptions="Center"
            Margin="0,0,0,12" />

        <Label
            Text="Nicole Rodrigues"
            FontSize="15"
            TextColor="#444444"
            HorizontalOptions="Center" />

        <Label
            Text="2508510"
            FontSize="15"
            TextColor="#444444"
            HorizontalOptions="Center" />

        <Label
            Text="30/09/2026"
            FontSize="15"
            TextColor="#444444"
            HorizontalOptions="Center"
            Margin="0,0,0,16" 
            BackgroundColor="Pink"/>

        <Button
            Text="Home"
            BackgroundColor="#4F35D2"
            TextColor="White"
            FontSize="14"
            CornerRadius="8"
            HeightRequest="45"
            HorizontalOptions="Fill"
            Clicked="OnHomeClicked" />

    </VerticalStackLayout>
</ContentPage>
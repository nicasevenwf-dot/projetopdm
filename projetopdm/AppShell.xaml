<?xml version="1.0" encoding="UTF-8" ?>

<Shell
    x:Class="projetopdm.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:projetopdm"
    Title="projetopdm"
    FlyoutBehavior="Flyout">

    <!-- HEADER DO FLYOUT -->
    <Shell.FlyoutHeader>
        <Grid
            Padding="20"
            HeightRequest="120">

            <VerticalStackLayout
                VerticalOptions="Center">

                <Label
                    Text="Sistema Acadêmico"
                    FontSize="22"
                    FontAttributes="Bold" />

                <Label
                    Text="Menu de opções"
                    FontSize="14" />

            </VerticalStackLayout>

        </Grid>
    </Shell.FlyoutHeader>


    <!-- FUNCIONALIDADES -->
    <FlyoutItem
        Title="Sistema Acadêmico"
        FlyoutDisplayOptions="AsMultipleItems">

        <Tab
            Title="Home"
            Icon="home.png">

            <ShellContent
                Title="Home"
                ContentTemplate="{DataTemplate local:MainPage}"
                Route="MainPage" />

        </Tab>

        <Tab
            Title="Períodos"
            Icon="periodo.png">

            <ShellContent
                Title="Períodos"
                ContentTemplate="{DataTemplate local:PeriodosPage}"
                Route="PeriodosPage" />

        </Tab>

        <Tab
            Title="Cursos"
            Icon="cursos.png">

            <ShellContent
                Title="Cursos"
                ContentTemplate="{DataTemplate local:CursosPage}"
                Route="CursosPage" />

        </Tab>

        <Tab
            Title="Disciplinas"
            Icon="disciplinas.png">

            <ShellContent
                Title="Disciplinas"
                ContentTemplate="{DataTemplate local:DisciplinasPage}"
                Route="DisciplinasPage" />

        </Tab>

    </FlyoutItem>


    <!-- FOOTER DO FLYOUT -->
    <Shell.FlyoutFooter>
        <Grid
            Padding="20"
            HeightRequest="70">

            <Label
                Text="2508510 • 2026"
                FontSize="12"
                HorizontalOptions="Center"
                VerticalOptions="Center" />

        </Grid>
    </Shell.FlyoutFooter>

</Shell>
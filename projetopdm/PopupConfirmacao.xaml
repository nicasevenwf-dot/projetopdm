<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="projetopdm.PopupConfirmacao"
    IsVisible="False"
    HorizontalOptions="Center"
    VerticalOptions="Center">

    <Border
        BackgroundColor="White"
        Stroke="#E5E7EB"
        StrokeThickness="1"
        WidthRequest="280">

        <Border.StrokeShape>
            <RoundRectangle CornerRadius="18" />
        </Border.StrokeShape>

        <Border.Shadow>
            <Shadow
                Brush="Black"
                Opacity="0.25"
                Radius="20"
                Offset="0,8" />
        </Border.Shadow>

        <VerticalStackLayout Padding="20,18" Spacing="10">

            <Label
                x:Name="lblIcone"
                FontSize="32"
                HorizontalOptions="Center" />

            <Label
                x:Name="lblTitulo"
                FontSize="18"
                FontAttributes="Bold"
                TextColor="#1F2A44"
                HorizontalTextAlignment="Center" />

            <Label
                x:Name="lblMensagem"
                FontSize="14"
                TextColor="#6B7280"
                HorizontalTextAlignment="Center" />

            <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="8"
                Margin="0,8,0,0">

                <Button
                    x:Name="btnCancelar"
                    Grid.Column="0"
                    BackgroundColor="#F3F4F6"
                    TextColor="#1F2A44"
                    CornerRadius="10"
                    Clicked="OnCancelarClicked" />

                <Button
                    x:Name="btnConfirmar"
                    Grid.Column="1"
                    TextColor="White"
                    CornerRadius="10"
                    Clicked="OnConfirmarClicked" />

            </Grid>

        </VerticalStackLayout>
    </Border>

</ContentView>
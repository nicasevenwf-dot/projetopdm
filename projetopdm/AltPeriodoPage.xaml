<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:projetopdm"
    x:Class="projetopdm.AltPeriodoPage"
    Title="Alterar Período"
    BackgroundColor="White">

    <Grid>

        <ScrollView>

            <VerticalStackLayout
                Padding="24,20"
                Spacing="12">

                <Label
                    Text="ALTERAR PERÍODO"
                    FontSize="26"
                    FontAttributes="Bold"
                    TextColor="#1F2A44"
                    HorizontalOptions="Center"
                    Margin="0,10,0,16" />

                <!-- NOME -->
                <Label
                    Text="Nome"
                    FontSize="16"
                    FontAttributes="Bold"
                    TextColor="#1F2A44" />

                <Border
                    BackgroundColor="White"
                    Stroke="#E5E7EB"
                    StrokeThickness="1"
                    Padding="10,2">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow
                            Brush="Black"
                            Opacity="0.08"
                            Radius="8"
                            Offset="0,3" />
                    </Border.Shadow>

                    <Entry
                        x:Name="txtNome"
                        Placeholder="Nome do período"
                        TextColor="#1F2A44"
                        PlaceholderColor="#9CA3AF" />
                </Border>

                <!-- SIGLA -->
                <Label
                    Text="Sigla"
                    FontSize="16"
                    FontAttributes="Bold"
                    TextColor="#1F2A44"
                    Margin="0,8,0,0" />

                <Border
                    BackgroundColor="White"
                    Stroke="#E5E7EB"
                    StrokeThickness="1"
                    Padding="10,2">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow
                            Brush="Black"
                            Opacity="0.08"
                            Radius="8"
                            Offset="0,3" />
                    </Border.Shadow>

                    <Entry
                        x:Name="txtSigla"
                        Placeholder="Sigla do período"
                        TextColor="#1F2A44"
                        PlaceholderColor="#9CA3AF" />
                </Border>

                <!-- DATA (NOVO) -->
                <Label
                    Text="Data"
                    FontSize="16"
                    FontAttributes="Bold"
                    TextColor="#1F2A44"
                    Margin="0,8,0,0" />

                <Border
                    BackgroundColor="White"
                    Stroke="#E5E7EB"
                    StrokeThickness="1"
                    Padding="10,2">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow
                            Brush="Black"
                            Opacity="0.08"
                            Radius="8"
                            Offset="0,3" />
                    </Border.Shadow>

                    <Entry
                        x:Name="txtData"
                        Placeholder="data"
                        TextColor="#1F2A44"
                        PlaceholderColor="#9CA3AF" />
                </Border>

                <Button
                    Text="SALVAR ALTERAÇÕES"
                    Margin="0,20,0,0"
                    Clicked="AlterarPeriodo"
                    BackgroundColor="Green"
                    TextColor="White"
                    CornerRadius="10" />

            </VerticalStackLayout>

        </ScrollView>

        <local:PopupConfirmacao x:Name="popup" />

    </Grid>

</ContentPage>